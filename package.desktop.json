{
  "name": "universechat",
  "version": "1.4.0",
  "description": "universeChat",
  "main": "main.js",
  "author": "universeChat",
  "dependencies": {
    "electron-updater": "5.3.0"
  },
  "devDependencies": {
    "electron": "22.3.27",
    "electron-builder": "23.6.0",
    "peerjs": "1.5.4"
  },
  "build": {
    "appId": "com.universechat.app",
    "productName": "universeChat",
    "files": ["main.js", "preload.js", "index.html", "peerjs.min.js"],
    "publish": [{ "provider": "github", "owner": "87universo-del", "repo": "UniverseChat-mobile", "releaseType": "release" }],
    "win": { "target": "nsis" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "artifactName": "universeChat-Setup-${version}.${ext}" }
  }
}
